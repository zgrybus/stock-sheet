{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/operations/import/{currency}": {
      "post": {
        "tags": ["operation-controller"],
        "operationId": "addOperations",
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationsBatchRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationImportResponseDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/operations/portfolio/{currency}": {
      "get": {
        "tags": ["operation-controller"],
        "operationId": "getPortfolioSummary",
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSummaryDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OperationRequestDTO": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1
          },
          "stockSymbol": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["BUY", "SELL"]
          },
          "volume": {
            "type": "number"
          },
          "openDate": {
            "type": "string",
            "format": "date-time"
          },
          "pricePerVolume": {
            "type": "number"
          },
          "totalPrice": {
            "type": "number"
          }
        },
        "required": [
          "externalId",
          "openDate",
          "pricePerVolume",
          "stockSymbol",
          "totalPrice",
          "type",
          "volume"
        ]
      },
      "OperationsBatchRequestDTO": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationRequestDTO"
            },
            "minItems": 1
          }
        },
        "required": ["operations"]
      },
      "OperationImportResponseDTO": {
        "type": "object",
        "properties": {
          "added": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationSummaryDTO"
            }
          },
          "duplicated": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationSummaryDTO"
            }
          }
        }
      },
      "OperationSummaryDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "externalId": {
            "type": "string"
          }
        }
      },
      "PortfolioSummaryDTO": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockPositionDTO"
            }
          }
        }
      },
      "StockPositionDTO": {
        "type": "object",
        "properties": {
          "stockSymbol": {
            "type": "string"
          },
          "totalVolume": {
            "type": "number"
          },
          "totalCost": {
            "type": "number"
          }
        }
      }
    }
  }
}
